<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgTopColor">#FF0D1117</Color>
    <Color x:Key="BgBottomColor">#FF161B22</Color>
    <Color x:Key="SurfaceColor">#FF21262D</Color>
    <Color x:Key="BorderColor">#FF30363D</Color>
    <Color x:Key="TextPrimaryColor">#FFE6EDF3</Color>
    <Color x:Key="TextMutedColor">#FF8B949E</Color>
    <Color x:Key="AccentColor">#FF3F91F4</Color>
    <Color x:Key="AccentHoverColor">#FF63A8F7</Color>
    <Color x:Key="AccentPressedColor">#FF2F7BD4</Color>
    <Color x:Key="SuccessColor">#FF3FB950</Color>
    <Color x:Key="DangerColor">#FFF85149</Color>
    <Color x:Key="WarningColor">#FFD29922</Color>

    <SolidColorBrush x:Key="BgTopBrush" Color="{StaticResource BgTopColor}" />
    <SolidColorBrush x:Key="BgBottomBrush" Color="{StaticResource BgBottomColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BgTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource BgBottomColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BannerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0A1628" Offset="0" />
        <GradientStop Color="#FF123A6B" Offset="0.45" />
        <GradientStop Color="#FF3F91F4" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
