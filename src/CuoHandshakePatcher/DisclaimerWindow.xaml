<Window x:Class="CuoHandshakePatcher.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disclaimer"
        Height="480" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">
    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
        <DockPanel Margin="22">
            <TextBlock DockPanel.Dock="Top" Text="Important Notice"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Decline" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Decline_Click" MinWidth="110" Margin="0,0,10,0" IsCancel="True" />
                <Button Content="I Understand &amp; Accept" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Accept_Click" MinWidth="170" IsDefault="True" />
            </StackPanel>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DisclaimerBody" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</Window>
