<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>CUO Handshake Fix</ApplicationTitle>
    <Product>CUO Handshake Fix</Product>
    <AssemblyName>CuoHandshakePatcher</AssemblyName>
    <RootNamespace>CuoHandshakePatcher</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\banner.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Build the net472 fix DLL, then embed it for extraction at patch time. -->
  <Target Name="BuildAndEmbedFixDll" BeforeTargets="PrepareForBuild">
    <!-- Do not forward RuntimeIdentifier — the fix DLL is net472 AnyCPU for RE. -->
    <MSBuild Projects="..\CuoHandshakeFix\CuoHandshakeFix.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=;RuntimeIdentifiers=" />
    <PropertyGroup>
      <_FixDll>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\CuoHandshakeFix\bin\$(Configuration)\net472\CuoHandshakeFix.dll'))</_FixDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(_FixDll)')" Text="CuoHandshakeFix.dll was not built at $(_FixDll)" />
    <ItemGroup>
      <EmbeddedResource Include="$(_FixDll)">
        <LogicalName>CuoHandshakeFix.dll</LogicalName>
        <Link>Resources\CuoHandshakeFix.dll</Link>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
